{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "spare_part_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "ENTRY",
        "EXIT",
        "ADJUSTMENT"
      ]
    },
    "quantity": {
      "type": "number"
    },
    "stock_after": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    }
  },
  "required": [
    "spare_part_id",
    "type",
    "quantity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}