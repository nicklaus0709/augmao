{
  "name": "MaintenancePlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "frequency_type": {
      "type": "string",
      "enum": [
        "DAILY",
        "WEEKLY",
        "MONTHLY",
        "QUARTERLY",
        "YEARLY",
        "HOURS_OF_USE"
      ],
      "default": "MONTHLY"
    },
    "frequency_value": {
      "type": "number",
      "default": 1
    },
    "estimated_minutes": {
      "type": "number"
    },
    "task_checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_to_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_run_at": {
      "type": "string"
    },
    "next_run_at": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "asset_id",
    "frequency_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}