{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "CORRECTIVE",
        "PREVENTIVE",
        "PREDICTIVE",
        "INSPECTION"
      ],
      "default": "CORRECTIVE"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "ASSIGNED",
        "IN_PROGRESS",
        "ON_HOLD",
        "COMPLETED",
        "CANCELLED"
      ],
      "default": "OPEN"
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "default": "MEDIUM"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "maintenance_plan_id": {
      "type": "string"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "estimated_minutes": {
      "type": "number"
    },
    "actual_minutes": {
      "type": "number"
    },
    "closing_notes": {
      "type": "string"
    },
    "failure_cause": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "title",
    "asset_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}