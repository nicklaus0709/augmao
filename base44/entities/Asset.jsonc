{
  "name": "Asset",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "MACHINERY",
        "VEHICLE",
        "ELECTRICAL",
        "HVAC",
        "FACILITY",
        "IT_EQUIPMENT",
        "OTHER"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "OPERATIONAL",
        "UNDER_MAINTENANCE",
        "OUT_OF_SERVICE",
        "RETIRED"
      ],
      "default": "OPERATIONAL"
    },
    "location": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "warranty_expires": {
      "type": "string",
      "format": "date"
    },
    "attributes": {
      "type": "object"
    },
    "parent_id": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "name",
    "category",
    "location"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}