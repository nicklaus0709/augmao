{
  "name": "User",
  "type": "object",
  "properties": {
    "app_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "SUPERVISOR",
        "TECHNICIAN",
        "VIEWER"
      ],
      "default": "VIEWER",
      "rls": {
        "write": false
      }
    },
    "phone": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "rls": {
        "write": false
      }
    }
  }
}