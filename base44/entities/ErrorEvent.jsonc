{
  "name": "ErrorEvent",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "backend",
        "frontend"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "error",
        "denied"
      ],
      "default": "error"
    },
    "fn": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "stack": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "release": {
      "type": "string"
    }
  },
  "required": [
    "source",
    "message"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$nor": [
            {
              "user_condition": {
                "data.active": false
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}