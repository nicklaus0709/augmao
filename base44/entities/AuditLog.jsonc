{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "changes": {
      "type": "object"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "entity"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$nor": [
            {
              "user_condition": {
                "data.active": false
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "SUPERVISOR"
              }
            },
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}