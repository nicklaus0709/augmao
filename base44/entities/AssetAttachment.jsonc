{
  "name": "AssetAttachment",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "file_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "number"
    }
  },
  "required": [
    "asset_id",
    "file_name",
    "file_uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}