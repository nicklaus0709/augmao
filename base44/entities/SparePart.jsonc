{
  "name": "SparePart",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "enum": [
        "unit",
        "liter",
        "kg",
        "meter",
        "kit"
      ],
      "default": "unit"
    },
    "stock_current": {
      "type": "number"
    },
    "stock_minimum": {
      "type": "number",
      "default": 1
    },
    "stock_maximum": {
      "type": "number"
    },
    "unit_cost": {
      "type": "number"
    },
    "location": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "name"
  ],
  "rls": {
    "read": {
      "$nor": [
        {
          "user_condition": {
            "data.active": false
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}